# =====================================================================
# AI Email Assistant - configuration template.
# Copy to `.env` and fill in. NEVER commit `.env` or anything in credentials/.
# =====================================================================

# --- General ----------------------------------------------------------
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                 # true = JSON logs (recommended in production)

# NOTE: everything below can also be changed in the web UI (python -m email_assistant ui);
# UI changes are saved to data/user_settings.json and override these values.
# Groq model names change over time - use the UI "Fetch available models" button if a model stops working.

# --- Groq LLM (free tier: https://console.groq.com/keys) ----------------
GROQ_API_KEY=gsk_replace_me
# Small/fast model for classification + meeting extraction (higher free limits)
GROQ_MODEL_FAST=openai/gpt-oss-20b
# Larger model for reply drafting (better writing quality)
GROQ_MODEL_QUALITY=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_OUTPUT_TOKENS=2048
# Client-side throttle; keep below your free-tier requests-per-minute limit
GROQ_REQUESTS_PER_MINUTE=20
LLM_TEMPERATURE=0.1
LLM_MAX_VALIDATION_ATTEMPTS=3
LLM_MAX_BODY_CHARS=4000

# --- Google OAuth ---------------------------------------------------------
GOOGLE_CLIENT_SECRETS_FILE=credentials/client_secret.json
GOOGLE_TOKEN_FILE=credentials/token.json
# Optional: encrypts the token file at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
GOOGLE_REQUESTS_PER_SECOND=5
GOOGLE_MAX_CONCURRENCY=4
GOOGLE_RETRY_MAX_ATTEMPTS=5

# --- Gmail ingestion --------------------------------------------------------
GMAIL_QUERY=in:inbox is:unread newer_than:2d -category:promotions -category:social
GMAIL_MAX_PER_RUN=15
MAX_CONCURRENT_EMAILS=2
POLL_INTERVAL_SECONDS=180
MAX_PROCESSING_ATTEMPTS=3
ENABLE_HEURISTIC_PREFILTER=true   # skips LLM for obvious bulk mail (saves free quota)

# --- Persistence --------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/assistant.db

# --- About you (used for drafting + scheduling) ---------------------------------
USER_NAME=Your Name
# Leave blank to auto-detect from the authenticated Gmail account
USER_EMAIL=
# IANA name, e.g. America/New_York, Europe/London, Asia/Kolkata
USER_TIMEZONE=UTC
USER_SIGNATURE=Best regards,\nYour Name
DEFAULT_TONE=formal             # formal | friendly | concise
CUSTOM_INSTRUCTIONS=            # e.g. Keep replies under 5 sentences. Never discuss pricing by email.
IGNORE_SENDERS=                 # comma list of addresses or @domains that are never processed
VIP_SENDERS=                    # comma list; never treated as spam, priority >= 4

# --- Scheduling ---------------------------------------------------------------
CALENDAR_ID=primary
WORKING_HOURS_START=09:00
WORKING_HOURS_END=17:30
WORK_DAYS=mon,tue,wed,thu,fri
DEFAULT_MEETING_MINUTES=30
MEETING_BUFFER_MINUTES=10
MIN_NOTICE_HOURS=2
SCHEDULING_HORIZON_DAYS=14
ADD_MEET_LINK=true

# --- Human-in-the-loop & guardrails --------------------------------------------
APPROVAL_TTL_HOURS=72
MIN_CLASSIFICATION_CONFIDENCE=0.6
MAX_DRAFT_CHARS=4000
# DANGEROUS: when true, SEND_EMAIL approvals are auto-granted for low-risk replies.
# Calendar invites ALWAYS require human approval regardless of this flag.
SEND_MODE=draft                 # draft = save as Gmail draft for you | auto = send automatically
AUTO_CREATE_EVENTS=false        # true = create calendar invites without asking
HOLD_RISKY_REPLIES=true         # in auto mode, still hold replies that need your attention

ALLOWED_SENDERS=   # empty = everyone
REQUIRE_AUTHENTICATED_SENDER=true
DAY_FIRST_DATES=true